# Обязательный секретный ключ Django (без него приложение не запустится)
SECRET_KEY=replace-me-with-a-secure-secret-key

# Режим отладки (1 / True — включен, 0 / False — выключен)
DEBUG=1

# Разрешённые хосты через запятую
ALLOWED_HOSTS=127.0.0.1,localhost

# Режим хранилища файлового менеджера: local (на диске) или s3 (Amazon S3)
STORAGE_BACKEND=local

# Ограничения размера загружаемых файлов (в байтах)
# По умолчанию: 10 МБ на один файл, 50 МБ на всю загрузку
MAX_UPLOAD_SIZE=10485760
MAX_TOTAL_UPLOAD_SIZE=52428800

# Настройки Amazon S3 (используются при STORAGE_BACKEND=s3)
# При деплое на EC2 с IAM-ролью ключи ACCESS_KEY указывать не нужно
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=