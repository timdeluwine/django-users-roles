SECRET_KEY=django-insecure-example-secret-key-change-in-production
DEBUG=True

# Хранилище файлов: 'local' или 's3'
STORAGE_BACKEND=local
MAX_FILE_SIZE_MB=10
MAX_TOTAL_STORAGE_MB=100

# Настройки AWS S3 (используются при STORAGE_BACKEND=s3)
AWS_STORAGE_BUCKET_NAME=my-file-manager-bucket
AWS_S3_REGION_NAME=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=